** sch_path: /foss/designs/sg13cmos5l_rodovalho_ip__sbcs/xschem/tb_sbcs_tran.sch
**.subckt tb_sbcs_tran
Xdut o avss avdd avss en enb sbcs
v_avss GND avss xavss
v_avdd avdd avss dc {xavdd}
v_en en avss {xen*xavdd} pwl( 0 0 1u 0 1.1u {xavdd} 19u {xavdd} 19.1u 0)
v_enb enb avss {(1-xen)*xavdd} pwl( 0 {xavdd} 1u {xavdd} 1.1u 0 19u 0 19.1u {xavdd})

v_o o avss dc {xvo}
**** begin user architecture code


.lib $PDK_ROOT/$PDK/libs.tech/ngspice/models/cornerMOShv.lib mos_tt




.option cshunt = 1e-15
.option gmin   = 1e-10
.control
  pre_osdi .lib $PDK_ROOT/$PDK/libs.tech/ngspice/models/osdi/psp103_nqs.osdi

  tran 10n 20u 10n uic
  let io = i(v_o)
  plot io ylimit 0 5u
.endc




.param xavdd = 3.3
.param xavss = 0
.param xvo   = 0
.param xen   = 1


**** end user architecture code
**.ends

