'../data/tb_sbcs_tsweeep.csv3' using 1:($2*1e6) with lines lt rgb 'blue',\
'../data/tb_sbcs_tsweeep.csv4' using 1:($2*1e6) with lines lt rgb 'blue',\
'../data/tb_sbcs_tsweeep.csv5' using 1:($2*1e6) with lines lt rgb 'blue',\
'../data/tb_sbcs_tsweeep.csv6' using 1:($2*1e6) with lines lt rgb 'blue',\
'../data/tb_sbcs_tsweeep.csv7' using 1:($2*1e6) with lines lt rgb 'blue',\
